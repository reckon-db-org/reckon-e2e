{erl_opts, [
    debug_info,
    warnings_as_errors
]}.

%% Pinned versions. Bump deliberately, document in CHANGELOG.
{deps, [
    {mem_evoq,     "0.1.2"},
    {reckon_evoq,  "~> 2.7.2"},
    {reckon_db,    "~> 5.4"},
    {evoq,         "~> 1.21"},
    {reckon_gater, "~> 3.6"},
    %% gRPC client for the clustered facade. Stubs are generated from
    %% priv/proto/*.proto (vendored copies of reckon-gateway's protos)
    %% via the grpcbox_plugin during `rebar3 compile'.
    {grpcbox,      "0.17.1"}
]}.

%% gRPC stub generation. Plugin runs as part of compile.
{plugins, [
    {grpcbox_plugin, "0.10.0"}
]}.

{project_plugins, [rebar3_lint]}.

%% Elvis style rules — shared macula_min ruleset (mirrors evoq/reckon-db).
%% Umbrella: lints each torture app's src. Run `rebar3 lint`.
{elvis, [
    {rulesets, #{
        macula_min => [
            {elvis_style, no_deep_nesting, #{level => 2}},
            {elvis_style, no_nested_try_catch, #{}},
            {elvis_style, no_if_expression, #{}}
        ]
    }},
    {config, [
        #{files => ["apps/*/src/**/*.erl"],
          ignore => [".*_pb", ".*_client", ".*_bhvr"],
          ruleset => macula_min}
    ]}
]}.

%% gRPC stub generation config lives in apps/reckon_e2e_grpc/rebar.config
%% — the plugin resolves paths relative to each app's directory.

%% Umbrella — each torture axis is an app under apps/.
{project_apps, [
    integrity_torture,
    adapter_swap_torture,
    reckon_e2e_grpc,
    multi_node_torture,
    multi_node_discovery,
    gateway_rpc_coverage
]}.

{shell, [
    {apps, [mem_evoq, integrity_torture]}
]}.

{profiles, [
    {test, [
        {deps, [
            {proper, "1.4.0"},
            {macula_testkit, "~> 0.2"}
        ]},
        {erl_opts, [debug_info, nowarn_export_all]}
    ]}
]}.

%% CT is the primary runner — scenarios take real time and want
%% per-testcase isolation. EUnit is reserved for tiny helper-module
%% checks within each torture app.
%% cth_skip_is_failure (macula_testkit): a skip nobody allowed fails the run,
%% because `rebar3 ct' exits 0 on a case that skipped itself (macula#43).
%% Every allowance below is a suite (or case) that needs a live cluster or
%% gateway; CI has none, so in CI these do not run, and this list says so
%% instead of a green board implying they did. A cluster CI job is an issue.
{ct_opts, [
    {dir, ["apps/integrity_torture/test",
           "apps/adapter_swap_torture/test",
           "apps/multi_node_torture/test",
           "apps/multi_node_discovery/test",
           "apps/gateway_rpc_coverage/test"]},
    {ct_hooks, [{cth_skip_is_failure, [{allow, [
        {adapter_swap_basic_SUITE, clustered_basic_scenario_matches_local,
         "runs only against a cluster (RECKON_E2E_CLUSTER), not in CI"},
        {gateway_rpc_coverage_SUITE, '*',
         "runs only against a reckon-gateway (RECKON_E2E_GATEWAY_COVERAGE), not in CI"},
        {catalogue_stores_SUITE, '*',
         "runs only against a catalogue gateway (RECKON_E2E_CATALOGUE), not in CI"},
        {multi_node_stores_failover_SUITE, '*',
         "runs only against a cluster (RECKON_E2E_CLUSTER), not in CI; its topology skips are live-cluster preconditions"},
        {multi_node_stores_list_SUITE, '*',
         "runs only against a cluster (RECKON_E2E_CLUSTER), not in CI"},
        {multi_node_stores_watch_SUITE, '*',
         "runs only against a cluster (RECKON_E2E_CLUSTER), not in CI; its topology skips are live-cluster preconditions"},
        {multi_node_leader_kill_SUITE, '*',
         "runs only against a cluster (RECKON_E2E_CLUSTER), not in CI"},
        {multi_node_partition_heal_SUITE, '*',
         "runs only against a cluster (RECKON_E2E_CLUSTER), not in CI"},
        {multi_node_replication_lag_SUITE, '*',
         "runs only against a cluster (RECKON_E2E_CLUSTER), not in CI"},
        {multi_node_subscription_failover_SUITE, '*',
         "runs only against a cluster (RECKON_E2E_CLUSTER), not in CI; its topology skips are live-cluster preconditions"}
    ]}]}]}
]}.

{eunit_opts, [verbose]}.

{cover_enabled, true}.

{dialyzer, [
    {warnings, [unknown, unmatched_returns, error_handling]},
    {plt_apps, top_level_deps}
]}.
